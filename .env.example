# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
# For local standalone usage, copy .env.example to .env and set your key. Never commit .env.
GEMINI_API_KEY=

# GEMINI_MODEL: Supported Gemini model ID (default: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (3000 in AI Studio preview; 8000 default for standalone python server.py).
PORT=3000
